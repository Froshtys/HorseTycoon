	{
  "LogName": "Horse Tycoon - Fertilizer Granulator Crafting Recipe",
  "Action": "EditData",
  "Target": "Data/CraftingRecipes",
  "Entries": {
    "{{ModId}}_FertilizerGranulator": "335 1 709 10 390 25 68 2/Home/{{ModId}}_FertilizerGranulator/true/none",
  }
},
{
  // The traveling cart may turn up with one of the six gradient saddles. 0.06 over the cart's ~35
  // openings a year (Fri/Sun, plus the three Night Market days, which reuse this same shop) works
  // out to roughly 2 sightings a year. @addDailyLuck adds the day's luck (-0.1 to +0.1) on top, so
  // a lucky day genuinely helps and an unlucky one can rule it out entirely.
  // SYNCED_RANDOM (not RANDOM) because shop conditions roll on Game1.random, which would otherwise
  // give every farmhand different stock. Deliberately ungated by year: the cart can turn up with a
  // gradient in year 1, before Leah starts selling them at the year-2 spring festival.
  "LogName": "Horse Tycoon - Random gradient saddle at the Traveling Cart",
  "Action": "EditData",
  "Target": "Data/Shops",
  "TargetField": [ "Traveler", "Items" ],
  "Entries": {
    "{{ModId}}_GradientSaddle": {
      "Id": "{{ModId}}_GradientSaddle",
      "RandomItemId": [
        "(O)HorseTycoon.SaddleSunset",
        "(O)HorseTycoon.SaddleOcean",
        "(O)HorseTycoon.SaddleAurora",
        "(O)HorseTycoon.SaddleMeadow",
        "(O)HorseTycoon.SaddleCandy",
        "(O)HorseTycoon.SaddleEmber"
      ],
      "Price": 6000,
      "AvailableStock": 1,
      "AvailableStockLimit": "Player",
      "Condition": "SYNCED_RANDOM day horsetycoon_cart_gradient_saddle 0.06 @addDailyLuck"
    }
  }
},
{
  // Both mannequins ride along on the cart at the same 6% + daily luck as the gradient saddles, on
  // their own SYNCED_RANDOM keys so they roll independently of each other and of the saddle (a
  // shared key would make them all show up on the same days). ~2.2 of each a year, ~4.4 total, so
  // the cart is a way to stock up on spares between festivals. 500g over Leah's festival price.
  "LogName": "Horse Tycoon - Horse mannequins at the Traveling Cart",
  "Action": "EditData",
  "Target": "Data/Shops",
  "TargetField": [ "Traveler", "Items" ],
  "Entries": {
    "{{ModId}}_WoodHorseMannequin": {
      "Id": "{{ModId}}_WoodHorseMannequin",
      "ItemId": "(F){{ModId}}.WoodHorseMannequin",
      "Price": 3000,
      "AvailableStock": 1,
      "AvailableStockLimit": "Player",
      "Condition": "SYNCED_RANDOM day horsetycoon_cart_wood_mannequin 0.06 @addDailyLuck"
    },
    "{{ModId}}_ClothHorseMannequin": {
      "Id": "{{ModId}}_ClothHorseMannequin",
      "ItemId": "(F){{ModId}}.ClothHorseMannequin",
      "Price": 3000,
      "AvailableStock": 1,
      "AvailableStockLimit": "Player",
      "Condition": "SYNCED_RANDOM day horsetycoon_cart_cloth_mannequin 0.06 @addDailyLuck"
    }
  }
},
