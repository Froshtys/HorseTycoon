							"Price": 1000,
							"AvailableStock": 2,
							"AvailableStockLimit": "Player"
						},
						/* Exactly one of the three potions appears per festival day: SYNCED_CHOICE
						   rolls one synced 0-2 value per day for the shared key, so the conditions
						   below are mutually exclusive and identical for every player. */
						/* Always stocked, unlike the IV potions: fixed count per player, per festival. */
						{
							"Id": "GallopPotion",
							"ItemId": "(O)HorseTycoon.GallopPotion",
							"Price": 500,
							"AvailableStock": 5,
							"AvailableStockLimit": "Player"
