{
	/*
	  IV potions + Isaac's festival shop.

	  Three potions, one per IV stat (Speed / Sprint / Jump). Giving one to a horse raises
	  that stat's IV by one grade (+10, handled in C#; see IVPotionManager). They are sold
	  only at Isaac's stall at the Summer Horse Festival: the shop stocks the Gold Carrot
	  Seeds (2 per player) plus exactly ONE of the three potions, picked at random per
	  festival day (SYNCED_CHOICE, same pick for every player) with quantity 1 per player.
	  The shop menu is opened from C# via Utility.TryOpenShopMenu (FestivalRaceManager.Shops).
	*/
	"Changes": [
		{
			"LogName": "IV potion textures",
			"Action": "Load",
			"Target": "{{ModId}}/IVPotionSpeed, {{ModId}}/IVPotionSprint, {{ModId}}/IVPotionJump, {{ModId}}/TrainingPotion, {{ModId}}/GallopPotion, {{ModId}}/CoatPotion",
			"FromFile": "assets/potions/{{TargetWithoutPath}}.png"
		},
		{
			"LogName": "IV potion objects",
			"Action": "EditData",
			"Target": "Data/Objects",
			"Entries": {
				"HorseTycoon.IVPotionSpeed": {
