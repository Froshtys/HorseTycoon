					"Type": "Basic",
					"Category": -999,
					"Price": 2500,
					"Texture": "{{ModId}}/IVPotionSpeed",
					"SpriteIndex": 0,
					"Edibility": -300,
					"IsDrink": false,
					"ExcludeFromFishingCollection": true,
					"ExcludeFromShippingCollection": true,
					"ExcludeFromRandomSale": true
				},
				"HorseTycoon.IVPotionSprint": {
					"Name": "Sprint Potion",
