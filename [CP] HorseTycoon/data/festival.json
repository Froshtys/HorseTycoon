			/* Willy's stall on the beach. The Seahorse is SVE's item when SVE is installed and our
			   duplicate of it otherwise (see data/seahorse.json), so the listing is ungated. */
			"LogName": "Fall Horse Festival - Willy's stall (seahorse)",
			"Action": "EditData",
			"Target": "Data/Shops",
			"Entries": {
				"Festival_FallHorseFestival_Willy": {
