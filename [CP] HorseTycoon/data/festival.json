									"Id": "Default",
									"Dialogue": "Ha! Y'want a horse for the festival? Well, this here's the only kind I can get ya."
								}
							],
							"RandomizeDialogueOnOpen": false,
							"ClosedMessage": null
						}
					],
					/* Listed cheapest first: the shop menu shows items in this order. */
					"Items": [
						/* Horse treats (see AppleTreatManager), at twice the apple's base price. */
						{ "Id": "Apple", "ItemId": "(O)613", "Price": 200, "AvailableStock": -1, "AvailableStockLimit": "Player" },
						/* Same listing Pierre runs at every horse festival (see data/goldcarrot.json).
						   Ungated for the same reason as the Seahorse: the item ID exists with or without SVE. */
						{ "Id": "GoldCarrotSeed", "ItemId": "FlashShifter.StardewValleyExpandedCP_Gold_Carrot_Seed", "Price": 500, "AvailableStock": 2, "AvailableStockLimit": "Player" },
						{ "Id": "Seahorse", "ItemId": "(O)FlashShifter.StardewValleyExpandedCP_Seahorse", "Price": 500, "AvailableStock": 3, "AvailableStockLimit": "Player" },
						/* -1 = unlimited, same as Pierre's carrot listings. */
						{ "Id": "ModernFishTank", "ItemId": "(F)2414", "Price": 1000, "AvailableStock": -1, "AvailableStockLimit": "Player" },
						{ "Id": "FishSmoker", "ItemId": "(BC)FishSmoker", "Price": 2000, "AvailableStock": 1, "AvailableStockLimit": "Player" },
						/* One pirate piece per year on a 3-year cycle, the same HorseTycoon_YEAR_MOD trick
						   Leah's saddle stock uses (Game1.year % divisor == remainder, registered in
						   ModEntry). Year 1 -> flag, year 2 -> rug, year 3 -> bed, then it repeats. */
