{
	/*
	  Festival stall keeper sprites — Alesia (Horse Trader), Isaac (Stud Master), and
	  Jadu (item stall) from Stardew Valley Expanded.

	  When SVE is installed it already loads these character sheets (Characters/Alesia etc.),
	  so we do nothing. Without SVE we load bundled copies of the same overworld sprites to
	  the same targets, so the C# spawner (FestivalRaceManager.Shops) can always build the
	  event actors from "Characters/<Name>". No Data/Characters entries are added — these
	  are event-actor-only sprites, not real villagers.
	*/
	"Changes": [
		{
			"LogName": "Festival stall keeper sprites (no SVE)",
			"Action": "Load",
			"Target": "Characters/Alesia, Characters/Isaac, Characters/Jadu",
			"FromFile": "assets/festivalnpcs/{{TargetWithoutPath}}.png",
			"When": { "HasMod |contains=FlashShifter.StardewValleyExpandedCP": false }
		},
		{
			"LogName": "Festival stall keeper portraits (no SVE)",
			"Action": "Load",
			"Target": "Portraits/Alesia, Portraits/Isaac, Portraits/Jadu",
			"FromFile": "assets/festivalnpcs/portraits/{{TargetWithoutPath}}.png",
			"When": { "HasMod |contains=FlashShifter.StardewValleyExpandedCP": false }
		}
	]
}
